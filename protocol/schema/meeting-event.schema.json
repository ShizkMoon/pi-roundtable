{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-roundtable.local/schema/v1/meeting-event.schema.json",
  "title": "Pi Roundtable meeting event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "meetingId",
    "eventId",
    "sequence",
    "runtimeGeneration",
    "kind",
    "occurredAt",
    "visibility",
    "payload"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "meetingId": { "$ref": "#/$defs/id" },
    "eventId": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "runtimeGeneration": { "type": "integer", "minimum": 1 },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "x-knownValues": [
        "runtime.lease_acquired",
        "runtime.lease_released",
        "meeting.opened",
        "meeting.closed",
        "message.published",
        "message.direct_sent",
        "role.registered",
        "role.temporary_registered",
        "role.promoted",
        "role.archived",
        "role.left",
        "speech.started",
        "speech.delta",
        "speech.completed",
        "speech.cancelled",
        "interruption.requested",
        "tool.started",
        "tool.completed",
        "tool.failed",
        "subagent.spawned",
        "subagent.progress",
        "subagent.completed",
        "subagent.failed"
      ]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "actorId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "targetId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "causationId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "visibility": { "enum": ["public", "private"] },
    "audience": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "payload": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": {
        "properties": { "visibility": { "const": "private" } },
        "required": ["visibility"]
      },
      "then": {
        "required": ["audience"],
        "properties": { "audience": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "visibility": { "const": "public" } },
        "required": ["visibility"]
      },
      "then": { "not": { "required": ["audience"] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }
  }
}
