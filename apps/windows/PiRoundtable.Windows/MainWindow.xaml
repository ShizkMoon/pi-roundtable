<Window
    x:Class="PiRoundtable.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PiRoundtable.Windows.Controls"
    xmlns:models="using:PiRoundtable.Windows.Models"
    Title="Pi Roundtable">

    <Grid
        x:Name="Root"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="Root_Loaded"
        SizeChanged="Root_SizeChanged">
        <Grid.Resources>
            <Style x:Key="RailButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Padding" Value="8,7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Padding="12,0,18,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Width="40"
                Height="40"
                Margin="0,0,8,0"
                AutomationProperties.Name="切换会话导航"
                Click="ToggleShellPane_Click"
                Content="☰"
                ToolTipService.ToolTip="会话与工作区导航" />
            <Border
                Grid.Column="1"
                Width="30"
                Height="30"
                VerticalAlignment="Center"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="9">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Mono"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Text="π" />
            </Border>
            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Pi Roundtable" />
                <TextBlock
                    x:Name="TitleSubtitle"
                    AutomationProperties.Name="应用副标题"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Windows 本地优先的多角色会议台" />
            </StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <ProgressRing Width="18" Height="18" IsActive="{Binding IsBusy}" />
                <Border x:Name="StatusBadge" Padding="10,5" AutomationProperties.Name="应用状态" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="12">
                    <TextBlock MaxWidth="280" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                </Border>
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="12,8,12,0"
            CloseButtonClick="ErrorInfoBar_CloseButtonClick"
            IsClosable="True"
            IsOpen="{Binding HasError, Mode=OneWay}"
            Message="{Binding ErrorMessage}"
            Severity="Error"
            Title="需要处理" />

        <SplitView
            x:Name="ShellSplitView"
            Grid.Row="2"
            Margin="12"
            CompactPaneLength="0"
            DisplayMode="Overlay"
            IsPaneOpen="False"
            OpenPaneLength="288"
            PanePlacement="Left">
            <SplitView.Pane>
                <Border
                    Margin="0,0,12,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid Padding="14" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel MinWidth="0" Spacing="2">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="会话" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="按项目或文件夹组织圆桌"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                AutomationProperties.Name="新建会话"
                                Click="NewSession_Click"
                                Content="＋"
                                ToolTipService.ToolTip="在当前分组中新建会话" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                AutomationProperties.Name="会话分组筛选"
                                IsEnabled="{Binding IsNotRunning}"
                                ItemsSource="{Binding SessionGroups}"
                                SelectedItem="{Binding SelectedSessionGroup, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                AutomationProperties.Name="新建会话分组"
                                Click="NewSessionGroup_Click"
                                Content="⌘"
                                IsEnabled="{Binding IsRoleConfigurationEditable}"
                                ToolTipService.ToolTip="新建项目或文件夹分组" />
                        </Grid>

                        <ListView
                            x:Name="SessionList"
                            Grid.Row="2"
                            ItemsSource="{Binding VisibleSessions}"
                            IsItemClickEnabled="True"
                            ItemClick="SessionList_ItemClick"
                            HorizontalContentAlignment="Stretch"
                            SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                            SelectionChanged="SessionList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SessionItem">
                                    <StackPanel AutomationProperties.Name="{x:Bind Title}" Padding="4,8" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Summary, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="3" Spacing="2">
                            <Rectangle Height="1" Margin="0,0,0,6" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Button AutomationProperties.Name="角色管理" Style="{StaticResource RailButtonStyle}" Click="NavigateRoles_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Width="20" HorizontalAlignment="Center" Text="◫" TextAlignment="Center" />
                                    <TextBlock Text="角色管理" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Skill" Style="{StaticResource RailButtonStyle}" Click="NavigateSkills_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Width="20" HorizontalAlignment="Center" Text="◇" TextAlignment="Center" />
                                    <TextBlock Text="Skill" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="MCP" Style="{StaticResource RailButtonStyle}" Click="NavigateMcp_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Width="20" HorizontalAlignment="Center" Text="⌁" TextAlignment="Center" />
                                    <TextBlock Text="MCP" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="设置" Style="{StaticResource RailButtonStyle}" Click="NavigateSettings_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Width="20" HorizontalAlignment="Center" Text="⚙" TextAlignment="Center" />
                                    <TextBlock Text="设置" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </SplitView.Pane>

            <Grid>
                <Grid x:Name="MeetingPage">
                    <SplitView
                        x:Name="ContextSplitView"
                        CompactPaneLength="0"
                        DisplayMode="Overlay"
                        IsPaneOpen="False"
                        OpenPaneLength="392"
                        PanePlacement="Right">
                        <SplitView.Pane>
                            <Border
                                Margin="12,0,0,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Grid>
                                    <Grid x:Name="PrivateChatPanel" Padding="16" RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontSize="19" FontWeight="SemiBold" Text="私聊" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="只进入所选角色的上下文" />
                                            </StackPanel>
                                            <Button Grid.Column="1" AutomationProperties.Name="关闭私聊侧栏" Click="CloseContextPane_Click" Content="×" ToolTipService.ToolTip="关闭侧栏" />
                                        </Grid>
                                        <ComboBox
                                            Grid.Row="1"
                                            AutomationProperties.Name="私聊角色"
                                            Header="当前角色"
                                            ItemsSource="{Binding Roles}"
                                            SelectedItem="{Binding SelectedPrivateRole, Mode=TwoWay}" />
                                        <ListView
                                            x:Name="PrivateTranscriptList"
                                            Grid.Row="2"
                                            ItemsSource="{Binding PrivateMessages}"
                                            Loaded="PrivateTranscriptList_Loaded"
                                            SelectionMode="None">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsStackPanel CacheLength="2" Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:TranscriptItem">
                                                    <Border Margin="0,4" Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10">
                                                        <StackPanel Spacing="5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Speaker}" />
                                                                <TextBlock Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind TimeLabel}" />
                                                            </Grid>
                                                            <controls:MarkdownMessageView ExternalLinkRequested="MarkdownMessage_ExternalLinkRequested" Text="{x:Bind Text, Mode=OneWay}" />
                                                            <TextBlock FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind State, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <Button
                                            x:Name="PrivateJumpToLatestButton"
                                            Grid.Row="2"
                                            Margin="0,0,12,12"
                                            Padding="12,6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            AutomationProperties.Name="私聊跳到最新消息"
                                            Click="PrivateJumpToLatest_Click"
                                            Content="跳到最新"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Visibility="Collapsed" />
                                        <StackPanel Grid.Row="3" Spacing="8">
                                            <TextBox
                                                x:Name="PrivatePromptBox"
                                                MinHeight="74"
                                                AcceptsReturn="True"
                                                AutomationProperties.Name="私聊发言输入"
                                                AutomationProperties.HelpText="按 Ctrl+Enter 发送私聊；Enter 换行"
                                                PlaceholderText="只对该角色可见……"
                                                TextWrapping="Wrap">
                                                <TextBox.KeyboardAccelerators>
                                                    <KeyboardAccelerator Invoked="SendPrivateAccelerator_Invoked" Key="Enter" Modifiers="Control" />
                                                </TextBox.KeyboardAccelerators>
                                            </TextBox>
                                            <Button
                                                HorizontalAlignment="Right"
                                                AutomationProperties.Name="发送私聊发言"
                                                Click="SendPrivate_Click"
                                                Content="发送私聊"
                                                IsEnabled="{Binding CanSendPrivate}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <ScrollViewer x:Name="RoleDetailPanel" Padding="18" Visibility="Collapsed">
                                        <StackPanel Spacing="14">
                                            <Button x:Name="RoleDetailBackButton" HorizontalAlignment="Left" Click="BackToPrivateChat_Click" Content="← 返回私聊" />
                                            <StackPanel Spacing="3">
                                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SelectedRole.DisplayName}" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SelectedRole.Summary}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10">
                                                <StackPanel Spacing="4">
                                                    <TextBlock FontWeight="SemiBold" Text="运行活动" />
                                                    <TextBlock Text="{Binding SelectedRole.ActivitySummary}" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="这里只显示生命周期与工具名称，不展示模型私有推理、工具参数或结果。"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <TextBox
                                                MinHeight="220"
                                                AcceptsReturn="True"
                                                Header="System Prompt 快照"
                                                IsReadOnly="True"
                                                Text="{Binding SelectedRole.SystemPrompt}"
                                                TextWrapping="Wrap" />
                                            <TextBlock FontWeight="SemiBold" Text="能力范围" />
                                            <TextBlock Text="{Binding SelectedRole.CapabilitiesSummary}" />
                                            <TextBlock FontWeight="SemiBold" Text="模型路由" />
                                            <TextBlock FontFamily="Cascadia Mono" Text="{Binding SelectedRole.ModelProfileId}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="InvitationPanel" Padding="18" Visibility="Collapsed">
                                        <StackPanel Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel MinWidth="0" Spacing="2">
                                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="邀请临时角色" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="完善提示词、模型和本次会话能力"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Click="CloseContextPane_Click" Content="×" ToolTipService.ToolTip="关闭邀请面板" />
                                            </Grid>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="邀请清单只对本次会话生效，并会冻结为该角色的能力快照。"
                                                TextWrapping="Wrap" />
                                            <TextBox x:Name="TemporaryRoleNameBox" Header="角色名称" PlaceholderText="系统策划" Text="{Binding TemporaryRoleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Header="本次邀请目的" PlaceholderText="为本场会议制定可执行方案" Text="{Binding TemporaryRolePurpose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox
                                                MinHeight="120"
                                                AcceptsReturn="True"
                                                Header="完整 System Prompt"
                                                PlaceholderText="定义职责、边界、输出格式与禁止事项……"
                                                Text="{Binding TemporaryRoleSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap" />
                                            <ComboBox AutomationProperties.Name="本会话模型路由" Header="本会话模型路由" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedInvitationModel, Mode=TwoWay}" />
                                            <ComboBox AutomationProperties.Name="邀请者" Header="邀请者" ItemsSource="{Binding InvitationInviterOptions}" SelectedValue="{Binding InvitationInviterId, Mode=TwoWay}" SelectedValuePath="Value" />
                                            <ComboBox AutomationProperties.Name="闭会处置" Header="闭会处置" ItemsSource="{Binding RetentionOptions}" SelectedValue="{Binding InvitationRetentionPolicy, Mode=TwoWay}" SelectedValuePath="Value" />
                                            <ComboBox AutomationProperties.Name="网络访问" Header="网络访问" ItemsSource="{Binding NetworkAccessOptions}" SelectedValue="{Binding InvitationNetworkAccess, Mode=TwoWay}" SelectedValuePath="Value" />
                                            <ListView Header="本会话 Skill / MCP 授权" ItemsSource="{Binding InvitationCapabilities}" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CapabilityGrantItem">
                                                        <CheckBox Padding="2,4" Content="{x:Bind DisplayName}" IsChecked="{x:Bind IsGranted, Mode=TwoWay}" />
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <TextBlock FontWeight="SemiBold" Text="MCP 工具精确授权" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="先勾选 MCP 服务器，再逐项选择已复核工具；空列表表示授权零工具。"
                                                TextWrapping="Wrap" />
                                            <ListView MaxHeight="180" ItemsSource="{Binding InvitationMcpTools}" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:McpToolGrantItem">
                                                        <CheckBox Padding="2,4" IsChecked="{x:Bind IsGranted, Mode=TwoWay}">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                                <TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Button
                                                HorizontalAlignment="Right"
                                                Click="AddTemporaryRole_Click"
                                                Content="发送邀请并创建"
                                                IsEnabled="{Binding CanInviteTemporaryRole}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer
                                        x:Name="ToolApprovalPanel"
                                        Padding="18"
                                        AutomationProperties.Name="SubAgent 活动与工具审批"
                                        IsTabStop="True"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="活动与审批" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="展示可审计状态；任务、参数、结果与模型私有推理保持隐藏" />
                                                </StackPanel>
                                                <Button Grid.Column="1" AutomationProperties.Name="关闭活动与审批面板" Click="CloseContextPane_Click" Content="×" ToolTipService.ToolTip="关闭活动面板" />
                                            </Grid>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding SubagentActivityLabel}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="当前没有 SubAgent 运行记录"
                                                Visibility="{Binding SubagentEmptyVisibility}" />
                                            <ListView AutomationProperties.Name="SubAgent 运行记录" MaxHeight="220" ItemsSource="{Binding SubagentRuns}" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SubagentRunItem">
                                                        <Border Margin="0,3" Padding="11" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10">
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel MinWidth="0" Spacing="3">
                                                                    <TextBlock FontWeight="SemiBold" MaxLines="2" Text="{x:Bind Summary, Mode=OneWay}" TextWrapping="Wrap" />
                                                                    <TextBlock FontFamily="Cascadia Mono" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ShortId}" ToolTipService.ToolTip="{x:Bind SubagentId}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" VerticalAlignment="Top" FontFamily="Cascadia Mono" FontSize="11" Text="{x:Bind StartedAtLabel}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding ToolApprovalSectionLabel}" />
                                            <InfoBar
                                                IsClosable="False"
                                                IsOpen="True"
                                                Message="批准会允许当前这一次工具调用继续；拒绝不会执行 MCP 副作用。"
                                                Severity="Informational"
                                                Title="最小披露" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="当前没有待处理工具审批"
                                                Visibility="{Binding ToolApprovalEmptyVisibility}" />
                                            <ListView x:Name="ToolApprovalList" AutomationProperties.Name="待处理工具审批" MaxHeight="280" ItemsSource="{Binding PendingToolApprovals}" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ToolApprovalItem">
                                                        <Border Margin="0,4" Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10">
                                                            <StackPanel Spacing="7">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ToolName}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind ToolName}" />
                                                                    <TextBlock Grid.Column="1" FontFamily="Cascadia Mono" FontSize="11" Text="{x:Bind RequestedAtLabel}" />
                                                                </Grid>
                                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ServerName}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind ServerName}" />
                                                                <TextBlock FontSize="11" Text="{x:Bind RoleName}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind RoleName}" />
                                                                <TextBlock FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind ExpiryLabel, Mode=OneWay}" TextWrapping="Wrap" />
                                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                                                    <Button Click="DenyToolApproval_Click" Content="拒绝" IsEnabled="{x:Bind CanResolve, Mode=OneWay}" Tag="{x:Bind ApprovalId}" />
                                                                    <Button Click="ApproveToolApproval_Click" Content="批准一次" IsEnabled="{x:Bind CanResolve, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind ApprovalId}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </SplitView.Pane>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid
                                    x:Name="MeetingHeaderGrid"
                                    Padding="16,8,8,6"
                                    AutomationProperties.Name="会议标题与主要操作"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel
                                        x:Name="MeetingTitleStack"
                                        VerticalAlignment="Center"
                                        Spacing="0">
                                        <TextBlock
                                            x:Name="MeetingHeaderLabel"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="当前圆桌" />
                                        <TextBox
                                            x:Name="MeetingTitleBox"
                                            MinWidth="120"
                                            MaxHeight="52"
                                            Padding="0,2"
                                            AutomationProperties.Name="会话名称"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Top"
                                            PlaceholderText="会话名称"
                                            Text="{Binding MeetingTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CommandBar
                                        x:Name="MeetingCommandBar"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        DefaultLabelPosition="Right">
                                        <AppBarButton AutomationProperties.Name="邀请临时角色" Click="OpenInvitationPane_Click" Label="邀请角色" Icon="AddFriend" ToolTipService.ToolTip="邀请临时角色" />
                                        <AppBarButton AutomationProperties.Name="打开角色私聊" Click="OpenPrivatePane_Click" Icon="Message" Label="私聊" ToolTipService.ToolTip="打开角色私聊" />
                                        <AppBarButton AutomationProperties.Name="查看活动与审批" Click="OpenToolApprovalPane_Click" Icon="Permissions" Label="{Binding ToolApprovalLabel}" ToolTipService.ToolTip="查看 SubAgent 活动和工具审批" />
                                        <AppBarButton
                                            AutomationProperties.Name="启动会议"
                                            Click="StartMeeting_Click"
                                            Icon="Play"
                                            IsEnabled="{Binding CanStart}"
                                            Label="启动"
                                            ToolTipService.ToolTip="启动本地会议"
                                            Visibility="{Binding StartMeetingVisibility}" />
                                        <AppBarButton
                                            AutomationProperties.Name="恢复会议"
                                            Click="StartMeeting_Click"
                                            Icon="Refresh"
                                            IsEnabled="{Binding CanResume}"
                                            Label="恢复"
                                            ToolTipService.ToolTip="从加密事件检查点恢复会议"
                                            Visibility="{Binding ResumeMeetingVisibility}" />
                                        <AppBarButton
                                            AutomationProperties.Name="暂停会议"
                                            Click="SuspendMeeting_Click"
                                            Icon="Pause"
                                            IsEnabled="{Binding CanPause}"
                                            Label="暂停"
                                            ToolTipService.ToolTip="暂停并释放本地 Runtime"
                                            Visibility="{Binding PauseMeetingVisibility}" />
                                        <CommandBar.SecondaryCommands>
                                            <AppBarButton Click="ExportSessionJson_Click" IsEnabled="{Binding IsNotRunning}" Label="导出会话包 JSON" />
                                            <AppBarButton Click="ExportSessionMarkdown_Click" IsEnabled="{Binding IsNotRunning}" Label="导出可读 Markdown" />
                                            <AppBarButton Click="ImportSessionPackage_Click" IsEnabled="{Binding IsNotRunning}" Label="导入会话包（先预检）" />
                                            <AppBarButton Click="CancelGeneration_Click" IsEnabled="{Binding CanOperate}" Label="停止生成" />
                                            <AppBarButton Click="CloseMeeting_Click" IsEnabled="{Binding CanClose}" Label="结束会议" />
                                        </CommandBar.SecondaryCommands>
                                    </CommandBar>
                                </Grid>

                                <Border
                                    Grid.Row="1"
                                    Padding="12,5"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="参会" />
                                        <TextBlock
                                            x:Name="ParticipantCompactText"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{Binding ParticipantSummary}"
                                            Visibility="Collapsed" />
                                        <ListView
                                            x:Name="ParticipantStrip"
                                            MaxHeight="56"
                                            ItemsSource="{Binding Roles}"
                                            IsItemClickEnabled="False"
                                            SelectionMode="None">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsStackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:RoleItem">
                                                    <Border
                                                        Margin="0,0,5,0"
                                                        Padding="9,4"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        CornerRadius="10"
                                                        ToolTipService.ToolTip="{x:Bind CapabilityGrantSummary}">
                                                        <StackPanel MaxWidth="250" Spacing="1">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CapabilityGrantSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                            <TextBlock
                                                x:Name="RuntimeStateText"
                                                MaxWidth="320"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Cascadia Mono"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding RuntimeStateSummary}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="MeetingSummaryText"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="会话摘要"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding MeetingSummary}" />
                                    </Grid>
                                </Border>

                                <Border
                                    x:Name="DiscussionControlStrip"
                                    Grid.Row="2"
                                    Padding="12,7"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Visibility="{Binding DiscussionStripVisibility}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Padding="9,3"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                            CornerRadius="9">
                                            <TextBlock
                                                AutomationProperties.Name="当前讨论模式"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="{Binding DiscussionModeLabel}" />
                                        </Border>
                                        <TextBlock
                                            x:Name="DiscussionAgendaText"
                                            Grid.Column="1"
                                            MaxWidth="460"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{Binding DiscussionAgendaSummary}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding DiscussionAgendaSummary}" />
                                        <TextBlock
                                            x:Name="DiscussionBudgetText"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontFamily="Cascadia Mono"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DiscussionBudgetSummary}" />
                                        <TextBlock
                                            x:Name="DiscussionQueueText"
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DiscussionQueueSummary}" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                                            <Button
                                                AutomationProperties.Name="切换讨论模式"
                                                Content="模式"
                                                IsEnabled="{Binding CanControlDiscussion}">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="SetAgendaMode_Click" Text="议程模式" />
                                                        <MenuFlyoutItem Click="SetFreeDiscussionMode_Click" Text="自由讨论" />
                                                        <MenuFlyoutItem Click="SetConvergenceMode_Click" Text="开始收敛" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="PauseDiscussion_Click" Text="暂停自动主持" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="进入下一议题"
                                                Click="AdvanceAgenda_Click"
                                                Content="下一议题"
                                                IsEnabled="{Binding CanAdvanceAgenda}" />
                                            <Button
                                                AutomationProperties.Name="继续自动主持"
                                                Click="ResumeDiscussion_Click"
                                                Content="继续"
                                                IsEnabled="{Binding CanResumeDiscussion}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="{Binding DiscussionResumeVisibility}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <InfoBar
                                    Grid.Row="3"
                                    Margin="12,8,12,0"
                                    IsClosable="False"
                                    IsOpen="{Binding IsPaused}"
                                    Message="上次运行已释放本地 Runtime 租约。恢复会先校验并回放加密事件日志，再继续新的 Runtime generation。"
                                    Severity="Informational"
                                    Title="会议已暂停">
                                    <InfoBar.ActionButton>
                                        <Button Click="StartMeeting_Click" Content="恢复会议" IsEnabled="{Binding CanResume}" />
                                    </InfoBar.ActionButton>
                                </InfoBar>

                                <Grid Grid.Row="4">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        MaxWidth="390"
                                        VerticalAlignment="Center"
                                        Spacing="10"
                                        Visibility="{Binding ProviderSetupVisibility}">
                                        <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="先连接一个模型提供商" />
                                        <TextBlock
                                            TextAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="密钥只保存到 Windows Credential Manager。完成提供商和模型配置后即可启动真实圆桌。"
                                            TextWrapping="Wrap" />
                                        <Button
                                            HorizontalAlignment="Center"
                                            AutomationProperties.Name="配置提供商"
                                            Click="ConfigureProvider_Click"
                                            Content="配置提供商"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False"
                                        MaxWidth="380"
                                        VerticalAlignment="Center"
                                        Spacing="7"
                                        Visibility="{Binding TranscriptEmptyVisibility}">
                                        <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="这场圆桌还没有公开发言" />
                                        <TextBlock
                                            TextAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="启动会议后，在下方以“我”的身份发送公开消息；所有角色都能看到，@ 只决定谁需要回应。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ListView
                                        x:Name="TranscriptList"
                                        AutomationProperties.Name="公开会话记录"
                                        Padding="14,8,18,8"
                                        ItemsSource="{Binding Transcript}"
                                        Loaded="TranscriptList_Loaded"
                                        SelectionMode="None">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel CacheLength="2" Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:TranscriptItem">
                                                <Border Margin="2,5" Padding="15" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10">
                                                    <StackPanel Spacing="7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button
                                                                Padding="0"
                                                                HorizontalAlignment="Left"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="TranscriptSpeaker_Click"
                                                                Content="{x:Bind Speaker}"
                                                                FontWeight="SemiBold"
                                                                Tag="{x:Bind RoleId}" />
                                                            <TextBlock Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind TimeLabel}" />
                                                        </Grid>
                                                        <controls:MarkdownMessageView ExternalLinkRequested="MarkdownMessage_ExternalLinkRequested" Text="{x:Bind Text, Mode=OneWay}" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind State, Mode=OneWay}" />
                                                            <Button
                                                                Grid.Column="1"
                                                                Padding="9,3"
                                                                AutomationProperties.Name="重试该角色"
                                                                Click="RetryTranscript_Click"
                                                                Content="重试该角色"
                                                                Tag="{x:Bind MessageId}"
                                                                Visibility="{x:Bind RetryVisibility, Mode=OneWay}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Button
                                        x:Name="TranscriptJumpToLatestButton"
                                        Margin="0,0,30,20"
                                        Padding="12,6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="公开记录跳到最新消息"
                                        Click="TranscriptJumpToLatest_Click"
                                        Content="跳到最新"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="Collapsed" />
                                </Grid>

                                <Grid
                                    Grid.Row="5"
                                    Padding="14,8,14,10"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox
                                        x:Name="PromptBox"
                                        MinHeight="68"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="公开发言输入"
                                        AutomationProperties.HelpText="直接描述要求、分工和依赖，用 @角色名 指定涉及角色；发送后自动理解和安排；按 Ctrl+Enter 发送，Enter 换行"
                                        Header="我 · 公开发言"
                                        PlaceholderText="直接描述共同要求、各自任务和协作关系；用 @角色名 指定涉及角色"
                                        TextWrapping="Wrap">
                                        <TextBox.KeyboardAccelerators>
                                            <KeyboardAccelerator Invoked="SendPromptAccelerator_Invoked" Key="Enter" Modifiers="Control" />
                                        </TextBox.KeyboardAccelerators>
                                    </TextBox>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="2"
                                            Text="未写 @：全员参与；多个 @：仅点名角色参与，自动理解分工与顺序 · Ctrl+Enter 发送"
                                            TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Click="Interrupt_Click" Content="打断并接管" IsEnabled="{Binding CanOperate}" />
                                            <Button AutomationProperties.Name="发送公开发言" Click="SendPrompt_Click" Content="发送" IsEnabled="{Binding CanSend}" Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </SplitView>
                </Grid>

                <Grid x:Name="RoleManagementPage" Visibility="Collapsed">
                    <SplitView
                        x:Name="RoleManagementSplitView"
                        CompactPaneLength="0"
                        DisplayMode="Overlay"
                        IsPaneOpen="False"
                        OpenPaneLength="300"
                        PanePlacement="Left">
                        <SplitView.Pane>
                            <Border
                                Margin="0,0,12,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Grid Padding="14" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="长期角色" />
                                        <Button Grid.Column="1" AutomationProperties.Name="新建长期角色" Click="NewLongTermRole_Click" Content="＋" IsEnabled="{Binding IsRoleConfigurationEditable}" />
                                    </Grid>
                                    <ListView Grid.Row="1" ItemsSource="{Binding LongTermRoles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:RoleItem">
                                                <StackPanel Padding="5,8" Spacing="3">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CapabilitiesSummary, Mode=OneWay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </SplitView.Pane>
                        <ScrollViewer>
                            <Grid MaxWidth="920" Padding="20" HorizontalAlignment="Center">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button AutomationProperties.Name="切换角色列表" Click="ToggleRoleList_Click" Content="☰" ToolTipService.ToolTip="角色列表" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="角色管理" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="长期角色的模型、系统提示词、Skill、MCP 与记忆策略" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedRole.DisplayName}" />
                                            <TextBox
                                                MinHeight="220"
                                                AcceptsReturn="True"
                                                Header="System Prompt"
                                                IsEnabled="{Binding IsRoleConfigurationEditable}"
                                                Text="{Binding SelectedRole.SystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap" />
                                            <ComboBox
                                                AutomationProperties.Name="角色模型"
                                                Header="该角色使用的模型"
                                                IsEnabled="{Binding IsRoleConfigurationEditable}"
                                                ItemsSource="{Binding Models}"
                                                SelectedItem="{Binding SelectedRoleModel, Mode=TwoWay}" />
                                            <TextBlock FontWeight="SemiBold" Text="Skill / MCP 显式授权" />
                                            <ListView MaxHeight="240" ItemsSource="{Binding AvailableCapabilities}" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CapabilityGrantItem">
                                                        <CheckBox Padding="2,6" IsChecked="{x:Bind IsGranted, Mode=TwoWay}">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Summary}" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <TextBlock FontWeight="SemiBold" Text="MCP 工具精确授权" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="服务器授权不会自动放开工具。仅下列已勾选、且仍存在于经复核目录中的工具会进入 Pi 工具表。"
                                                TextWrapping="Wrap" />
                                            <ListView MaxHeight="240" ItemsSource="{Binding AvailableMcpTools}" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:McpToolGrantItem">
                                                        <CheckBox Padding="2,6" IsChecked="{x:Bind IsGranted, Mode=TwoWay}">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                                <TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Border Padding="12" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="9">
                                                <StackPanel Spacing="3">
                                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="长期记忆与提示词演进" />
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="策略已持久化；记忆内容写入和提示词自优化执行仍为 planned。" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                                <Button AutomationProperties.Name="归档当前角色" Click="ArchiveRole_Click" Content="归档" IsEnabled="{Binding CanArchiveSelectedRole}" />
                                                <Button AutomationProperties.Name="保存当前角色配置" Click="SaveRole_Click" Content="保存角色配置" IsEnabled="{Binding IsRoleConfigurationEditable}" Style="{StaticResource AccentButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </SplitView>
                </Grid>

                <ScrollViewer x:Name="SkillPage" Visibility="Collapsed">
                    <Grid MaxWidth="940" Padding="20" HorizontalAlignment="Center">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Skill" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="公共 Skill 目录、LLM 审阅与隔离安装" />
                            </StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{Binding IsRoleConfigurationEditable}">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="从 Git 平台导入" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="客户端在隔离临时目录下载，向所选模型发送有界文本快照，复核路径后原子安装；高风险结果保持禁用。" TextWrapping="Wrap" />
                                    <ComboBox AutomationProperties.Name="Skill 导入审阅模型" Header="LLM 审阅模型" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedImportModel, Mode=TwoWay}" />
                                    <TextBox Header="名称（可选，留空由 LLM 建议）" Text="{Binding SkillDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="说明（可选，留空由 LLM 建议）" Text="{Binding SkillDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="GitHub / Git HTTPS 地址" PlaceholderText="https://github.com/org/repo/tree/main/skill" Text="{Binding SkillSourceLocator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button HorizontalAlignment="Right" Click="SaveSkill_Click" Content="LLM 审阅并导入" IsEnabled="{Binding IsRoleConfigurationEditable}" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                                </ContentControl>
                            </Border>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="已登记 Skill" />
                            <ListView MaxHeight="480" ItemsSource="{Binding Skills}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SkillProfileConfiguration">
                                        <Border Margin="0,4" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                                <TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Source.Locator}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind ImportStatus}" />
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Risk}" />
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind AuditSummary}" TextWrapping="Wrap" />
                                                <Button HorizontalAlignment="Right" Click="ApproveSkill_Click" Content="审核并启用" Tag="{x:Bind SkillId}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="McpPage" Visibility="Collapsed">
                    <Grid MaxWidth="940" Padding="20" HorizontalAlignment="Center">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="MCP" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="公共 MCP 服务器目录与最小授权入口" />
                            </StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{Binding IsRoleConfigurationEditable}">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="从 Git 平台导入 MCP" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="LLM 识别 stdio 启动入口，客户端校验并安装；导入结果默认禁用，必须人工审核后才进入角色能力列表。" TextWrapping="Wrap" />
                                    <ComboBox AutomationProperties.Name="MCP 导入审阅模型" Header="LLM 审阅模型" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedImportModel, Mode=TwoWay}" />
                                    <TextBox Header="名称（可选，留空由 LLM 建议）" Text="{Binding McpDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="GitHub / Git HTTPS 地址" PlaceholderText="https://github.com/org/repo" Text="{Binding McpSourceLocator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button HorizontalAlignment="Right" AutomationProperties.Name="LLM 审阅并隔离导入 MCP" Click="ImportMcp_Click" Content="LLM 审阅并隔离导入" IsEnabled="{Binding IsRoleConfigurationEditable}" Style="{StaticResource AccentButtonStyle}" />
                                    <Expander Header="手动登记 MCP 服务器">
                                        <StackPanel Padding="0,8,0,0" Spacing="10">
                                            <ComboBox AutomationProperties.Name="MCP 传输方式" Header="传输" ItemsSource="{Binding McpTransports}" SelectedItem="{Binding McpTransport, Mode=TwoWay}" />
                                            <TextBox Header="命令或端点" Text="{Binding McpCommandOrEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox
                                                MinHeight="96"
                                                AcceptsReturn="True"
                                                Header="已复核工具名称（每行一个，必须与 MCP 返回名称完全一致）"
                                                PlaceholderText="read_file&#x0a;search_docs"
                                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                ScrollViewer.HorizontalScrollMode="Enabled"
                                                Text="{Binding McpToolCatalogText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="NoWrap" />
                                            <Button HorizontalAlignment="Right" AutomationProperties.Name="登记 MCP 并保持禁用" Click="SaveMcp_Click" Content="登记并保持禁用" IsEnabled="{Binding IsRoleConfigurationEditable}" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                </ContentControl>
                            </Border>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="已登记 MCP" />
                            <ListView MaxHeight="480" ItemsSource="{Binding McpServers}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:McpServerProfileConfiguration">
                                        <Border Margin="0,4" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Transport}" />
                                                <TextBlock FontFamily="Cascadia Mono" FontSize="11" Text="{x:Bind Command}" TextWrapping="Wrap" />
                                                <TextBlock FontFamily="Cascadia Mono" FontSize="11" Text="{x:Bind Endpoint}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="已复核工具：" />
                                                    <TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ToolCatalog.Count, Mode=OneTime}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind ImportStatus}" />
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Risk}" />
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind AuditSummary}" TextWrapping="Wrap" />
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                                    <Button AutomationProperties.Name="编辑 MCP 工具清单" Click="EditMcpTools_Click" Content="编辑工具清单" Tag="{x:Bind McpServerId}" />
                                                    <Button AutomationProperties.Name="审核并启用 MCP" Click="ApproveMcp_Click" Content="审核并启用" Tag="{x:Bind McpServerId}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid MaxWidth="940" Padding="20" HorizontalAlignment="Center">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="设置" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="提供商、模型、远端同步与客户端外观" />
                            </StackPanel>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="软件更新" />
                                            <TextBlock x:Name="CurrentVersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button x:Name="CheckForUpdatesButton" Grid.Column="1" AutomationProperties.Name="检查软件更新" Click="CheckForUpdates_Click" Content="检查更新" />
                                    </Grid>
                                    <TextBlock x:Name="UpdateStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="尚未检查。更新清单必须通过应用内固定公钥验证。" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="UpdateProgressBar" Maximum="100" Minimum="0" Visibility="Collapsed" />
                                    <Button x:Name="InstallUpdateButton" HorizontalAlignment="Right" AutomationProperties.Name="下载并安装已验证更新" Click="InstallUpdate_Click" Content="下载并安装" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="安装前会再次核对精确字节数与 SHA-256；随后客户端正常结束本地 Runtime，由独立辅助程序等待退出、请求 UAC 并执行 MSI。只有安装成功才重启客户端。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{Binding IsRoleConfigurationEditable}">
                                <StackPanel Spacing="12">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="提供商与模型" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="非敏感配置写入长期 JSON；密钥只写 Windows Credential Manager。" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox AutomationProperties.Name="提供商选择" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" />
                                        <Button Grid.Column="1" AutomationProperties.Name="新建提供商" Click="BeginNewProvider_Click" Content="新建" IsEnabled="{Binding IsRoleConfigurationEditable}" />
                                    </Grid>
                                    <TextBox x:Name="ProviderDisplayNameBox" AutomationProperties.Name="提供商显示名称" Header="显示名称" Text="{Binding ProviderDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Runtime Provider ID" PlaceholderText="openai / anthropic / google" Text="{Binding RuntimeProviderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox AutomationProperties.Name="API 家族" Header="API 家族" ItemsSource="{Binding ApiFamilies}" SelectedItem="{Binding ApiFamily, Mode=TwoWay}" />
                                    <TextBox Header="可选端点" PlaceholderText="HTTPS 或回环 HTTP" Text="{Binding ProviderEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <PasswordBox x:Name="ProviderApiKeyBox" Header="API Key（留空则保留现有值）" PasswordRevealMode="Peek" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                        <Button AutomationProperties.Name="获取提供商模型列表" Click="FetchProviderModels_Click" Content="获取模型列表" />
                                        <Button AutomationProperties.Name="保存提供商与凭据" Click="SaveProvider_Click" Content="保存提供商与凭据" Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                    <Border Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10">
                                        <StackPanel Spacing="8">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding DiscoveredModelSummary}" TextWrapping="Wrap" />
                                                <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                                    <Button AutomationProperties.Name="全选发现的模型" Click="SelectAllProviderModels_Click" Content="全选" />
                                                    <Button AutomationProperties.Name="导入已选模型" Click="ImportProviderModels_Click" Content="导入已选" Style="{StaticResource AccentButtonStyle}" />
                                                </StackPanel>
                                            </Grid>
                                            <ListView MaxHeight="260" ItemsSource="{Binding DiscoveredModels}" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ProviderModelCandidate">
                                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                                            <StackPanel Margin="4,2" Spacing="2">
                                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind MetadataSummary}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Border>
                                    <Expander Header="手动添加或编辑单个模型">
                                        <StackPanel Padding="0,8,0,0" Spacing="10">
                                            <TextBox Header="模型显示名称" Text="{Binding ModelDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Header="模型 ID" Text="{Binding ModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="填写模型 ID 后再次保存提供商，即可新增或更新单个模型。" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                </ContentControl>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{Binding IsRoleConfigurationEditable}">
                                <StackPanel Spacing="12">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="客户端与远端同步" />
                                    <ComboBox AutomationProperties.Name="配色模式" Header="配色模式" ItemsSource="{Binding ThemeOptions}" SelectedValue="{Binding ThemeMode, Mode=TwoWay}" SelectedValuePath="Value" />
                                    <ToggleSwitch Header="启用远端 Linux 同步服务器" IsOn="{Binding RemoteSyncEnabled, Mode=TwoWay}" />
                                    <TextBox Header="同步服务器端点" PlaceholderText="https://roundtable.example.com" Text="{Binding RemoteSyncEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <PasswordBox x:Name="SyncCredentialBox" Header="同步凭据（留空则保留）" PasswordRevealMode="Peek" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="端点与凭据持久化已实现；服务端已支持设备令牌与私有 audience，Windows 客户端连接和 E2EE 仍为 pending。" TextWrapping="Wrap" />
                                    <Button HorizontalAlignment="Right" Click="SaveClientSettings_Click" Content="保存客户端设置" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                                </ContentControl>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock FontWeight="SemiBold" Text="Runtime Owner" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Windows · 本机进程 · .NET 10" />
                                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="代次 / 事件序号" />
                                    <TextBlock FontFamily="Cascadia Mono" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding GenerationSummary}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </SplitView>
    </Grid>
</Window>
